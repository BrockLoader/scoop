DATABASE_URL=postgresql+psycopg2://scoop:scoop@db:5432/scoop
DEFAULT_POSTCODE=4000
SCRAPE_CACHE_TTL_SECONDS=1800

ENABLE_DANMURPHYS=true
ENABLE_BWS=true
ENABLE_LIQUORLAND=true

# Per-retailer timeouts (seconds)
SCRAPE_TIMEOUT_SECONDS=15

# CORS — frontend port + any public hostname the user points at
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Logging level (DEBUG / INFO / WARNING / ERROR)
LOG_LEVEL=INFO